POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=fraud_rule_engine
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud
POSTGRES_HOST_PORT=5432
APP_HOST_PORT=8080
REDPANDA_IMAGE=redpandadata/redpanda:v26.1.11
REDPANDA_HOST_PORT=19092
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DATASOURCE_HIKARI_POOL_NAME=FraudRuleEngineHikariPool
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_AUTO_COMMIT=true
SPRING_DATASOURCE_HIKARI_TRANSACTION_ISOLATION=TRANSACTION_READ_COMMITTED
SPRING_KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=fraud-rule-engine-service
FRAUD_KAFKA_ENABLED=true
FRAUD_KAFKA_TRANSACTION_EVENTS_TOPIC=transaction-events
FRAUD_KAFKA_DEAD_LETTER_TOPIC=transaction-events.dlq
FRAUD_KAFKA_CONSUMER_GROUP=fraud-rule-engine-service
FRAUD_KAFKA_EXPECTED_EVENT_TYPE=TransactionEvaluationRequested
FRAUD_KAFKA_SUPPORTED_SCHEMA_VERSION=1
FRAUD_KAFKA_RETRY_MAX_ATTEMPTS=3
FRAUD_KAFKA_RETRY_BACKOFF=PT2S
FRAUD_SECURITY_JWT_ISSUER_URI=fraud-rule-engine-local
FRAUD_SECURITY_JWT_AUDIENCES=fraud-rule-engine-service
FRAUD_SECURITY_JWT_PUBLIC_KEY_LOCATION=classpath:security/local-dev-public-key.pem
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
LOGGING_LEVEL_HIBERNATE_CONNECTION_POOLING=WARN
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
